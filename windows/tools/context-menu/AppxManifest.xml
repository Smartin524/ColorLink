<?xml version="1.0" encoding="utf-8"?>
<!--
  稀疏包（sparse package）：只给 ColorLink 一个包标识，好让 Windows 11 右键菜单第一级显示「发送到 手机名」。
  程序文件不在包里，在安装目录（Add-AppxPackage -ExternalLocation）；包里只有这个清单和几张图标。
  由 tools/context-menu.ps1 打包、签名、注册。Version 由脚本填。
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
    xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
    xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
    xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
    xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap uap10 desktop4 desktop5 desktop6 com rescap">

  <Identity Name="ColorLink.ContextMenu" Publisher="CN=ColorLink Dev" Version="$VERSION$" ProcessorArchitecture="neutral" />

  <Properties>
    <DisplayName>ColorLink</DisplayName>
    <PublisherDisplayName>ColorLink</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
    <!-- 不虚拟化 AppData：菜单要读 ColorLink 的 paired.json（手机名），日志也写到同一个地方 -->
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="zh-CN" />
  </Resources>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>

  <Applications>
    <Application Id="ColorLinkShell" Executable="ColorLinkShell.exe" uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements AppListEntry="none" DisplayName="ColorLink" Description="ColorLink 右键菜单"
                          BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="ColorLinkSend" Clsid="439BE09B-BA94-42A6-AF64-A06F628AFD16" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="ColorLinkShell.exe" Arguments="-Embedding" DisplayName="ColorLink 右键菜单">
              <com:Class Id="439BE09B-BA94-42A6-AF64-A06F628AFD16" DisplayName="ColorLink 发送到手机" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>

<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ColorLink.App.PairWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid RowDefinitions="Auto,*">
        <Grid x:Name="TitleBar" Height="48" Padding="16,0,140,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/ColorLink.png" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="配对手机" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <StackPanel Grid.Row="1" Padding="24,4,24,24" Spacing="14">
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="在手机上打开 ColorLink，首页会显示 6 位配对码。手机和电脑要在同一个 Wi-Fi，或者电脑连着手机热点。" />

            <ComboBox x:Name="PhonePicker" Header="手机" HorizontalAlignment="Stretch" SelectionChanged="PhonePicker_SelectionChanged" />
            <TextBox x:Name="AddressBox" Header="地址" PlaceholderText="192.168.1.23:8765" Visibility="Collapsed" />
            <TextBox x:Name="CodeBox" Header="配对码" PlaceholderText="手机上显示的 6 位数字" MaxLength="6"
                     InputScope="Number" TextChanged="CodeBox_TextChanged" KeyDown="CodeBox_KeyDown" />

            <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="False" IsOpen="False" />

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SearchingText" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <ProgressRing x:Name="Busy" Grid.Column="1" Width="18" Height="18" IsActive="False" />
                <Button x:Name="PairButton" Grid.Column="2" Content="配对" Style="{StaticResource AccentButtonStyle}"
                        MinWidth="96" IsEnabled="False" Click="Pair_Click" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>

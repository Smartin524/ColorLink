<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ColorLink.App.GalleryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ColorLink.App">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" RowDefinitions="Auto,Auto,*,Auto" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
        <Grid.Resources>
            <CollectionViewSource x:Name="Groups" IsSourceGrouped="True" />

            <DataTemplate x:Key="ThumbTemplate" x:DataType="local:MediaItemVM">
                <Grid Width="132" Height="132" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <Image Source="{x:Bind Thumb, Mode=OneWay}" Stretch="UniformToFill" />
                    <Border Visibility="{x:Bind DownloadedVisibility, Mode=OneWay}" Width="18" Height="18" CornerRadius="9" Margin="5"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Background="#90000000">
                        <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="White" />
                    </Border>
                    <Border Visibility="{x:Bind DurationVisibility}" Padding="5,1" CornerRadius="4" Margin="5"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#90000000">
                        <TextBlock Text="{x:Bind DurationText}" FontSize="11" Foreground="White" />
                    </Border>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="AudioTemplate" x:DataType="local:MediaItemVM">
                <Grid ColumnSpacing="12" Padding="4,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8D6;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{x:Bind Item.Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{x:Bind DurationText}" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <!-- 标题栏（内容延伸进标题栏，Mica 一直透到顶） -->
        <Grid x:Name="TitleBar" Height="48" Padding="16,0,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="CaptionSpace" Width="140" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/ColorLink.png" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock x:Name="WindowTitle" Grid.Column="1" Text="相册" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <!-- 工具栏 -->
        <Grid Grid.Row="1" Padding="12,0,16,6" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar x:Name="KindBar" SelectionChanged="KindBar_SelectionChanged">
                <SelectorBarItem Text="照片" Tag="image" IsSelected="True" />
                <SelectorBarItem Text="视频" Tag="video" />
                <SelectorBarItem Text="音频" Tag="audio" />
            </SelectorBar>
            <TextBlock x:Name="CountText" Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ProgressRing x:Name="SyncRing" Grid.Column="2" Width="16" Height="16" IsActive="False" />
            <CommandBar Grid.Column="3" DefaultLabelPosition="Right" Background="Transparent" IsOpen="False">
                <AppBarButton x:Name="SendButton" Label="发送到手机" Click="Send_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE898;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="刷新" Click="Refresh_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE72C;" /></AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <CommandBar.SecondaryCommands>
                    <AppBarButton Label="打开保存文件夹" Click="OpenFolder_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE838;" /></AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>

        <!-- 照片 / 视频：按天分组的网格 -->
        <GridView x:Name="Grid" Grid.Row="2" Padding="12,0,12,12" SelectionMode="Extended" IsItemClickEnabled="False"
                  ItemTemplate="{StaticResource ThumbTemplate}"
                  ContainerContentChanging="Grid_ContainerContentChanging" DoubleTapped="Items_DoubleTapped"
                  CanDragItems="True" DragItemsStarting="Grid_DragItemsStarting" KeyDown="Items_KeyDown"
                  ContextRequested="Items_ContextRequested">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                    <Setter Property="Margin" Value="2" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="local:DayGroup">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </GridView.GroupStyle>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
        </GridView>

        <!-- 音频：列表 -->
        <ListView x:Name="AudioList" Grid.Row="2" Padding="12,0,12,12" SelectionMode="Extended" Visibility="Collapsed"
                  ItemTemplate="{StaticResource AudioTemplate}" DoubleTapped="Items_DoubleTapped" KeyDown="Items_KeyDown"
                  ContextRequested="Items_ContextRequested" />

        <StackPanel x:Name="EmptyState" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Visibility="Collapsed">
            <FontIcon Glyph="&#xE91B;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- 拖文件进窗口时的提示 -->
        <Border x:Name="DropOverlay" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed" Margin="12" CornerRadius="12"
                BorderThickness="2" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" IsHitTestVisible="False">
            <Border.Background>
                <SolidColorBrush Color="{ThemeResource SystemAccentColor}" Opacity="0.10" />
            </Border.Background>
            <TextBlock x:Name="DropText" Text="松手发送到手机" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        </Border>

        <InfoBar x:Name="Status" Grid.Row="3" Margin="12,0,12,12" IsOpen="False" IsClosable="True" />
    </Grid>
</Window>

<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ColorLink.App.PanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" AllowDrop="True" DragOver="Root_DragOver" DragLeave="Root_DragLeave" Drop="Root_Drop"
          Background="Transparent">
        <StackPanel x:Name="Body" Padding="14,12,14,14" Spacing="10" VerticalAlignment="Top" SizeChanged="Body_SizeChanged">
            <!-- 顶部：连接状态 + 小圆按钮 -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="PhoneGlyph" Glyph="&#xE8EA;" FontSize="18" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" x:Name="Buttons">
                    <Button x:Name="DndButton" Style="{StaticResource CircleButton}" Click="Dnd_Click" AutomationProperties.Name="免打扰">
                        <FontIcon x:Name="DndGlyph" Glyph="&#xE708;" FontSize="13" />
                    </Button>
                    <Button x:Name="GalleryButton" Style="{StaticResource CircleButton}" Click="Gallery_Click" AutomationProperties.Name="打开相册"
                            ToolTipService.ToolTip="打开相册">
                        <FontIcon Glyph="&#xE91B;" FontSize="13" />
                    </Button>
                    <Button x:Name="MoreButton" Style="{StaticResource CircleButton}" ToolTipService.ToolTip="更多" AutomationProperties.Name="更多">
                        <FontIcon Glyph="&#xE712;" FontSize="13" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="MoreMenu" Placement="BottomEdgeAlignedRight" Opening="MoreMenu_Opening" />
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 照片区：最近三张；悬停时上半“下载”、下半“复制” -->
            <Border x:Name="Strip" CornerRadius="10" Padding="5"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid x:Name="StripGrid" ColumnSpacing="5" Height="88">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </Border>
        </StackPanel>

        <!-- 拖文件进来时盖满整个面板 -->
        <Border x:Name="DropOverlay" Visibility="Collapsed" Margin="8" CornerRadius="12" BorderThickness="1.5"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" IsHitTestVisible="False">
            <Border.Background>
                <SolidColorBrush Color="{ThemeResource SystemAccentColor}" Opacity="0.12" />
            </Border.Background>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                <FontIcon x:Name="DropGlyph" Glyph="&#xE896;" FontSize="26" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock x:Name="DropText" Text="松手发送到手机" HorizontalAlignment="Center"
                           Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

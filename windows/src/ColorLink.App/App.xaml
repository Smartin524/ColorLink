<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ColorLink.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- 链环的品牌蓝，和图标一致 -->
            <Color x:Key="BrandBlue">#FF0A6CFF</Color>
            <SolidColorBrush x:Key="BrandBlueBrush" Color="{StaticResource BrandBlue}" />
            <SolidColorBrush x:Key="ConnectedBrush" Color="#FF16A34A" />
            <!-- 面板顶部的小圆按钮 -->
            <Style x:Key="CircleButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="15" />
            </Style>
            <Style x:Key="AccentCircleButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="15" />
            </Style>
            <!-- 缩略图上悬停出现的半边按钮 -->
            <Style x:Key="HalfButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="#66000000" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
